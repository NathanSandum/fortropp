{
	on_demand_tls {
		ask http://localhost:5555/
	}
}

{$CADDY_SITE_ADDRESS:localhost:80} {
	handle /api/* {
		reverse_proxy worker:8080
	}

	handle /.well-known/oauth-* {
		reverse_proxy worker:8080
	}

	header /oauth/* {
		Content-Security-Policy "frame-ancestors 'none'"
		X-Frame-Options "DENY"
	}

	handle {
		root * /srv
		file_server
	}
}

http://localhost:5555 {
	@test expression {query.domain}.endsWith(".test")
	respond @test 200
	respond 403
}

https:// {
	tls internal {
		on_demand
	}
	reverse_proxy {$WORKER_ADDRESS}
}
