handle /api/* {
	reverse_proxy {args[0]} {
		header_up X-Real-IP {client_ip}
	}
}

handle /.well-known/oauth-* {
	reverse_proxy {args[0]} {
		header_up X-Real-IP {client_ip}
	}
}

header /oauth/* {
	Content-Security-Policy "frame-ancestors 'none'"
	X-Frame-Options "DENY"
}

handle {
	root * /srv
	file_server
}
