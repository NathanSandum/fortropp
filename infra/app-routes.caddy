handle /api/* {
	reverse_proxy {args[0]}
}

handle /.well-known/oauth-* {
	reverse_proxy {args[0]}
}

header /oauth/* {
	Content-Security-Policy "frame-ancestors 'none'"
	X-Frame-Options "DENY"
}

handle {
	root * /srv
	@website path_regexp ^/dashboard/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/
	rewrite @website /fallback.html
	file_server
}
