{
	auto_https disable_redirects
}

fortropp.dev {
	tls /etc/fortropp/origin.pem /etc/fortropp/origin-key.pem
	import app-routes.caddy backend:8080
}

http:// {
	@challenges path /.well-known/cf-custom-hostname-challenge/* /.well-known/acme-challenge/* /.well-known/pki-validation/*
	handle @challenges {
		reverse_proxy backend:8080
	}
	handle {
		abort
	}
}
